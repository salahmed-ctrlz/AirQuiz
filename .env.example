# Frontend (only needed when running `npm run dev`; the packaged app is same-origin)
# VITE_API_URL=http://localhost:8000
# VITE_SOCKET_URL=http://localhost:8000
# VITE_DEMO_MODE=false

# Backend (read by backend/config.py)
# ADMIN_PASSWORD=          # unset = random password generated in data/admin_password.txt
# AIRQUIZ_DATA_DIR=./data  # database, exams, password live here
# BACKEND_HOST=0.0.0.0
# BACKEND_PORT=8000
# CORS_ORIGINS=*
# DEFAULT_ROOM_CAPACITY=300
# AIRQUIZ_ALLOW_TEST_USER=  # dev only: TEST/TEST joins any room
